import streamlit as st

st.title("Cadastro de Informações")
nome = st.text_input("Qual é o seu nome?")
idade = st.number_input("Qual é a sua idade?", min_value=0)
peso = st.number_input("Qual é o seu peso?", min_value=0.0)
altura = st.number_input("Qual é a sua altura?", min_value=0.0)

if st.button("Enviar"):
    st.write(f"Olá, {nome}!")
    st.write(f"Idade: {idade} anos")
    st.write(f"Peso: {peso} kg")
    st.write(f"Altura: {altura} cm")
